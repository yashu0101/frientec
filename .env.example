# Copy to .env for local use, or set these on the host.

# Port the API (and, in production, the built React app) listens on.
PORT=4000

# Where the JSON store lives. Leave unset locally — it defaults to ./data.
# On a container host this MUST point at a mounted volume, or every redeploy
# throws away the leads and orders.
# DATA_DIR=/data

# Optional. Without it the app runs exactly the same and the studio drafts
# pages on the device instead of asking Claude.
# ANTHROPIC_API_KEY=sk-ant-...

# --- only when the front end is hosted apart from the API -------------------
# Origins allowed to call this API. Unset = same-origin only, no CORS headers.
# CORS_ORIGIN=https://frientec-client.vercel.app

# Set at BUILD time on the front-end host (Vercel), not here. Without it the
# client asks its own origin for /api, /img and /sites — which a static host
# does not have, so the catalogue loads empty.
# VITE_API_BASE=https://your-api-host

# --- the store: pick one -----------------------------------------------------
# nothing set        -> ./data/*.json   (local)
# DATA_DIR=/data     -> JSON files on a mounted volume (a host that sells a disk)
# DATABASE_URL=...   -> one Postgres table, five JSONB rows (any free tier)
# DATABASE_URL wins when both are set.
# DATABASE_URL=postgres://user:pass@host.neon.tech/dbname?sslmode=require
