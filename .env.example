# Copy to .env for local use, or set these on the host.

# Port the API (and, in production, the built React app) listens on.
PORT=4000

# Where the JSON store lives. Leave unset locally — it defaults to ./data.
# On a container host this MUST point at a mounted volume, or every redeploy
# throws away the leads and orders.
# DATA_DIR=/data

# Optional. Without it the app runs exactly the same and the studio drafts
# pages on the device instead of asking Claude.
# ANTHROPIC_API_KEY=sk-ant-...
